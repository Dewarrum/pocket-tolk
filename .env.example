# Pocket Tolk backend configuration. Placeholder values only.
# Local dev: copy to ~/.config/pocket-tolk/.env (outside the repo); dev.sh loads it.
# Production: set the same names as Fly secrets.

# --- Server ---
PORT=8080
# Shared bearer token the app sends; dev.sh defaults it to dev-token.
APP_TOKEN=change-me
# Exact frontend origin allowed by CORS; dev.sh defaults it to http://localhost:5173.
ALLOWED_ORIGIN=https://pocket-tolk.pages.dev
PROVIDER_TIMEOUT_SECONDS=30
MAX_UPLOAD_MB=25

# --- Speech-to-text (slice 1) ---
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=gsk_placeholder
STT_MODEL=whisper-large-v3-turbo

# --- Translation (slice 2) ---
# OpenRouter chat completions. The fallback model answers once when the
# primary fails or times out. CONTEXT_TURNS earlier turns go with each request.
TRANSLATE_BASE_URL=https://openrouter.ai/api/v1
TRANSLATE_API_KEY=sk-or-placeholder
TRANSLATE_MODEL=openai/gpt-6-luna
TRANSLATE_FALLBACK_MODEL=anthropic/claude-haiku-5.5
TRANSLATE_CONTEXT_TURNS=10
# OpenRouter reasoning.effort for both models: none, minimal, low, medium, high.
TRANSLATE_REASONING_EFFORT=minimal

# --- Text-to-speech (slice 3) ---
# Cartesia POST /tts/bytes, mp3. The voice per language is in the backend's
# language table; Cantonese has none and the phone's own voice speaks it.
TTS_BASE_URL=https://api.cartesia.ai
TTS_API_KEY=sk_car_placeholder
TTS_MODEL=sonic-3.6
